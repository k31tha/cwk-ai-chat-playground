# OpenAI API Key (Required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (Required if using Anthropic models)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-your-key-here

# Gemini API Key (Required if using Gemini models)
# Get yours at: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your-key-here

# Weather API Key (Optional - for real weather data)
# Get a free key at: https://openweathermap.org/api
WEATHER_API_KEY=your-weather-key-here
